PROJECT_NAME=SSPILLOWY
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=supersecretkey_change_me_in_production_123456789

# Supabase (recomendado) — Project Settings → Database → Connection string → URI
# Usa el pooler (Transaction) si Railway no conecta por IPv6:
# postgresql://postgres.XXXX:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Datos demo reales (repos/findings/scans):
#   - Automático al arrancar la API si la DB está vacía
#   - O: cd apps/api && python seed_data.py
#   - O: POST /api/v1/admin/seed
#   - O: ejecutar apps/api/seed.sql en Supabase SQL Editor

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sspillowy_db

REDIS_HOST=redis
REDIS_PORT=6379

BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:5173"

FRONTEND_URL=http://localhost:5173

# Producción (sspillowy.com):
# Cloudflare DNS → CNAME api → [valor que dé Railway]
# Railway → FRONTEND_URL=https://sspillowy.com
# Railway → GOOGLE_REDIRECT_URI=https://api.sspillowy.com/api/v1/auth/google/callback
# Railway → GITHUB_REDIRECT_URI=https://api.sspillowy.com/api/v1/auth/github/callback
# Railway → GITLAB_REDIRECT_URI=https://api.sspillowy.com/api/v1/auth/gitlab/callback
# Railway → MICROSOFT_REDIRECT_URI=https://api.sspillowy.com/api/v1/auth/microsoft/callback
# Vercel  → VITE_API_URL=https://api.sspillowy.com  (luego Redeploy)
# Railway → API_PUBLIC_URL=https://api.sspillowy.com
# Correo verificación (elige uno):
#   Resend → RESEND_API_KEY=re_...  EMAIL_FROM=SSPILLOWY <noreply@sspillowy.com>
#   SMTP (Bluehost) → SMTP_HOST=mail.tudominio.com SMTP_PORT=587 SMTP_USER=... SMTP_PASSWORD=...

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:8000/api/v1/auth/gitlab/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

MICROSOFT_TENANT=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# Pillow (Gemini) — solo en servidor (Railway). No commitear la key real.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACKS=gemini-flash-latest
PILLOW_DAILY_CREDITS=2
# Correos con panel admin Pillow (separados por coma). Solo ellos ven «Admin créditos».
PILLOW_ADMIN_EMAILS=seba.tralma.dev@gmail.com

# Semgrep (escaneo real al pulsar "Ejecutar Escaneo")
# Se instala en la imagen Docker. Opcional:
SEMGREP_CONFIG=p/ci
SEMGREP_MAX_FINDINGS=40
# Si el clone falla (repo privado/inexistente), escanea fixture local vulnerable:
SEMGREP_FALLBACK_FIXTURE=true
# Token opcional para clonar repos privados de GitHub:
GITHUB_TOKEN=
