PROJECT_NAME=SSPILLOWY
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=supersecretkey_change_me_in_production_123456789

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sspillowy_db

REDIS_HOST=redis
REDIS_PORT=6379

BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:5173"

FRONTEND_URL=http://localhost:5173

# Producción:
# Railway → FRONTEND_URL=https://tu-app.vercel.app
# Vercel  → VITE_API_URL=https://tu-servicio.up.railway.app  (sin barra final; rebuild)
# En cada OAuth app añade el callback de Railway, sin borrar localhost.

# GitHub OAuth (gratis). Crear app en https://github.com/settings/developers
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:8000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# GitLab.com OAuth (gratis). Crear app en https://gitlab.com/-/user_settings/applications
# Redirect URI: http://localhost:8000/api/v1/auth/gitlab/callback
# Scopes: read_user
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:8000/api/v1/auth/gitlab/callback

# Google OAuth (gratis, modo Testing hasta 100 correos). 
# Consent: https://console.cloud.google.com/apis/credentials/consent
# Credenciales Web: redirect http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Microsoft Entra (gratis). App registration:
# https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Accounts: personal + any org (common)
# Redirect URI tipo Web: http://localhost:8000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
