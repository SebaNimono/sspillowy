PROJECT_NAME=SSPILLOWY
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=supersecretkey_change_me_in_production_123456789

# Supabase (recomendado) — Project Settings → Database → Connection string → URI
# Usa el pooler (Transaction) si Railway no conecta por IPv6:
# postgresql://postgres.XXXX:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sspillowy_db

REDIS_HOST=redis
REDIS_PORT=6379

BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:5173"

FRONTEND_URL=http://localhost:5173

# Producción:
# Railway → FRONTEND_URL=https://tu-app.vercel.app
# Railway → DATABASE_URL=... (Supabase URI)
# Vercel  → VITE_API_URL=https://tu-servicio.up.railway.app

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:8000/api/v1/auth/gitlab/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

MICROSOFT_TENANT=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
